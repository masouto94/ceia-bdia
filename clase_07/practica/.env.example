POSTGRES_DB=bdia_rls
POSTGRES_USER=bdia_admin
POSTGRES_PASSWORD=bdia_admin_pass
POSTGRES_PORT=5435

PGADMIN_DEFAULT_EMAIL=admin@bdia.com
PGADMIN_DEFAULT_PASSWORD=bdia_pgadmin_local_pass
PGADMIN_PORT=8087

MODELO_EMBEDDING=intfloat/multilingual-e5-small

# Extensión opcional: generación con un LLM vía OpenRouter, usada por
# scripts/responder_rag.py (CLI) y por la interfaz web (servicio web-ui).
# Conseguir una key en https://openrouter.ai/keys. El resto de la práctica no la necesita.
EMBEDDINGS_API_PORT=8011
WEB_PORT=3001
OPENROUTER_API_KEY=tu_api_key_real_de_openrouter
OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
# OPENROUTER_MODEL=google/gemma-4-26b-a4b-it
# OPENROUTER_MODEL=google/gemma-4-31b-it:free
# OPENROUTER_MODEL=google/gemma-4-31b-it
APLICACION_DB_USER=aplicacion
APLICACION_DB_PASSWORD=aplicacion_pass
APLICACION_SOLO_LECTURA_DB_USER=aplicacion_solo_lectura
APLICACION_SOLO_LECTURA_DB_PASSWORD=solo_lectura_pass