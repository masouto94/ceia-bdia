---
import BaseLayout from "../layouts/BaseLayout.astro";

const appUrl = import.meta.env.PUBLIC_APP_URL ?? "http://localhost:5173";
const pasos = [
  ["01", "Registrá", "Vinculá datasets, modelos, ejecuciones, parámetros, resultados, métricas y procedencia."],
  ["02", "Evolucioná", "Prepará datos confiables y conocimiento técnico para que el equipo conserve contexto."],
  ["03", "Consultá", "Revisá evidencia documental y resultados con trazabilidad de las fuentes utilizadas."],
];
const secciones = [
  ["#panorama", "Panorama"], ["#experimentos", "Experimentos"], ["#datos", "Datos"], ["#documentos", "Documentos"], ["#asistente", "Asistente"], ["#seguridad", "Seguridad"], ["#estado", "Estado"], ["#recorrido", "Recorrido"],
];
---
<BaseLayout title="Espacio de experimentos" description="Espacio educativo para experimentos de IA, datos y conocimiento técnico.">
  <header class="header"><div class="nav-shell">
    <a class="brand" href="#inicio">Espacio de experimentos</a>
    <nav class="nav nav-links" aria-label="Navegación principal">{secciones.map(([href, label]) => <a href={href}>{label}</a>)}</nav>
    <div class="nav nav-action"><button class="theme" type="button" aria-label="Activar tema oscuro" aria-pressed="false" data-theme-toggle>☾</button><a class="nav-login-button" href={`${appUrl}/login`}>Acceder al sistema</a></div>
    <details class="mobile-menu"><summary class="theme" aria-label="Abrir navegación"><span class="menu-icon" aria-hidden="true"><span></span><span></span><span></span></span></summary><nav aria-label="Navegación móvil">{secciones.map(([href, label]) => <a href={href}>{label}</a>)}<a class="mobile-login-button" href={`${appUrl}/login`}>Acceder al sistema</a></nav></details>
  </div></header>
  <main id="main">
    <section id="inicio" class="section-shell"><div class="section-container hero-grid"><div class="hero-copy"><p class="eyebrow">Espacio de Experimentos</p><h1>Registrá, consultá y explicá el trabajo de tus experimentos de IA.</h1><p class="section-copy">Un espacio de trabajo diseñado para unir la evidencia que suele quedar dispersa entre pruebas, datos y documentos técnicos.</p><div class="actions"><a class="button" href={`${appUrl}/register`}>Crear espacio</a><a class="button secondary" href="#recorrido">Ver cómo funciona</a></div></div><aside class="surface-card hero-panel" aria-label="Resumen del espacio de experimentos"><div class="hero-symbol" aria-hidden="true">↗</div><h2>Contexto para cada resultado.</h2><p>Una composición de registro, evolución, consulta y evidencia para que el equipo revise decisiones con una referencia común.</p></aside></div></section>
    <section id="panorama" class="section-shell fade-in-section"><div class="section-container"><p class="eyebrow">Panorama del producto</p><h2 class="section-title">El problema no es solo experimentar: es recuperar el contexto disperso de cada experimento.</h2><div class="card-grid"><article class="surface-card card"><h3>Una fuente de verdad</h3><p>El workspace está diseñado para relacionar la evidencia operativa con la pregunta técnica que originó cada prueba.</p></article><article class="surface-card card"><h3>Decisiones revisables</h3><p>Resultados, métricas y fuentes quedan preparados para una lectura compartida, no como datos aislados.</p></article><article class="surface-card card"><h3>Diseño educativo</h3><p>La propuesta convierte los temas del semestre en un recorrido escaneable y verificable.</p></article></div></div></section>
    <section id="experimentos" class="section-shell fade-in-section"><div class="section-container"><p class="eyebrow">Modelo de experimento</p><h2 class="section-title">Cada ejecución conserva su red de datos, modelo y resultado.</h2><div class="architecture-band"><strong>datasets, modelos, ejecuciones, parámetros, resultados, métricas y procedencia</strong><span>La relación entre estas entidades permite explicar qué se corrió, con qué configuración y qué evidencia produjo.</span></div></div></section>
    <section id="datos" class="section-shell fade-in-section"><div class="section-container"><p class="eyebrow">Evolución de datos</p><h2 class="section-title">Estructura para consultar y flexibilidad para aprender de nuevas fuentes.</h2><div class="card-grid"><article class="surface-card card"><h3>Modelos complementarios</h3><p>modelos relacionales y documentales organizan registros consistentes y contenido técnico de distinta forma.</p></article><article class="surface-card card"><h3>Calidad progresiva</h3><p>El pipeline Bronze, Silver y Gold separa recepción, depuración y datos listos para análisis.</p></article><article class="surface-card card"><h3>Procedencia visible</h3><p>Cada etapa está pensada para mantener el origen y las transformaciones necesarias para interpretar resultados.</p></article></div></div></section>
    <section id="documentos" class="section-shell fade-in-section"><div class="section-container"><p class="eyebrow">Documentos técnicos</p><h2 class="section-title">Del archivo privado a una respuesta con citas.</h2><div class="architecture-band"><strong>archivos fuente privados en MinIO → chunks, embeddings, recuperación semántica y citas/RAG</strong><span>El producto está diseñado para apoyar respuestas contextualizadas, preservando los documentos y sus referencias.</span></div></div></section>
    <section id="asistente" class="section-shell fade-in-section"><div class="section-container"><p class="eyebrow">Modos del asistente</p><h2 class="section-title">La consulta cambia de modo, no de evidencia.</h2><div class="card-grid"><article class="surface-card card"><h3>Documental</h3><p>Recupera pasajes técnicos y sus citas cuando la respuesta vive en el conocimiento documental.</p></article><article class="surface-card card"><h3>Experimentos · Text-to-SQL de solo lectura</h3><p>Consulta resultados estructurados sin modificar datos y expone la procedencia SQL de la respuesta.</p></article><article class="surface-card card"><h3>Combinado / automático</h3><p>Orquesta evidencia documental y experimental según la pregunta, manteniendo fuentes y procedencia SQL.</p></article></div></div></section>
    <section id="seguridad" class="section-shell fade-in-section"><div class="section-container"><p class="eyebrow">Seguridad multi-tenant</p><h2 class="section-title">El aislamiento no depende de una elección en pantalla.</h2><div class="architecture-band"><strong>Roles fijos: admin, member y viewer · RLS · SQL de solo lectura</strong><span>El contexto del tenant controlado por el backend mantiene la sesión sin selector de tenant y limitada a su pertenencia asignada.</span></div></div></section>
    <section id="estado" class="section-shell fade-in-section"><div class="section-container"><p class="eyebrow">Estado explícito</p><h2 class="section-title">Una base disponible hoy; capacidades técnicas preparadas para el siguiente tramo.</h2><div class="card-grid status-grid"><article class="surface-card card"><p class="status-label">Disponible ahora</p><h3>Fundación de acceso y navegación</h3><p>Identidad, roles fijos y la sesión aislada por tenant sostienen el ingreso y la navegación del workspace.</p></article><article class="surface-card card"><p class="status-label">Próximas capacidades</p><h3>Registro y consulta completa</h3><p>El modelo de experimentos, la evolución de datos, RAG y los modos del asistente describen lo que el workspace está diseñado para soportar, no funciones ya operativas.</p></article></div></div></section>
    <section id="recorrido" class="section-shell fade-in-section"><div class="section-container"><p class="eyebrow">Cómo funciona · Recorrido completo</p><h2 class="section-title">Del dato de origen a una decisión que el equipo puede explicar.</h2><div class="card-grid">{pasos.map(([numero, titulo, texto]) => <article class="surface-card card"><span class="step-number">{numero}</span><h3>{titulo}</h3><p>{texto}</p></article>)}</div></div></section>
    <section id="comenzar" class="section-shell cta fade-in-section"><div class="section-container"><p class="eyebrow">Empezá por el acceso</p><h2 class="section-title">Creá tu espacio o ingresá para trabajar sobre una base aislada por tenant.</h2><p class="section-copy">La fundación actual permite identidad, roles y navegación; el recorrido técnico marca el horizonte del producto.</p><div class="actions"><a class="button" href={`${appUrl}/register`}>Crear espacio</a><a class="button secondary" href={`${appUrl}/login`}>Ingresar</a></div></div></section>
  </main>
  <footer class="footer"><div class="section-container footer-row"><strong>Espacio de experimentos</strong><p>Aplicación educativa para experimentos, datos y conocimiento técnico.</p></div></footer>
  <script is:inline>const key = "student-project-theme"; const root = document.documentElement; const toggles = document.querySelectorAll("[data-theme-toggle]"); const readTheme = () => root.dataset.theme === "dark" ? "dark" : "light"; const persistTheme = (theme) => { try { localStorage.setItem(key, theme); } catch {} }; const updateToggle = (theme) => { const dark = theme === "dark"; toggles.forEach((control) => { control.setAttribute("aria-pressed", String(dark)); control.setAttribute("aria-label", dark ? "Activar tema claro" : "Activar tema oscuro"); control.textContent = dark ? "☀" : "☾"; }); }; const applyTheme = (theme, persist = false) => { root.dataset.theme = theme; root.style.colorScheme = theme; updateToggle(theme); if (persist) persistTheme(theme); }; applyTheme(readTheme()); toggles.forEach((control) => control.addEventListener("click", () => applyTheme(readTheme() === "dark" ? "light" : "dark", true))); document.querySelectorAll(".mobile-menu a").forEach((link) => link.addEventListener("click", () => { link.closest("details").open = false; })); const sections = document.querySelectorAll(".fade-in-section"); if ("IntersectionObserver" in window) { const observer = new IntersectionObserver((entries) => entries.forEach((entry) => { if (entry.isIntersecting) { entry.target.classList.add("is-visible"); observer.unobserve(entry.target); } }), { threshold: .15 }); sections.forEach((section) => observer.observe(section)); } else { sections.forEach((section) => section.classList.add("is-visible")); }</script>
</BaseLayout>
